{
  "name": "nextjs-starter-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "eslint:lint": "eslint \"{pages,modules,shared}/**/*.{ts,tsx}\" --fix --max-warnings=0",
    "postinstall": "next telemetry disable",
    "prettier:format": "npx prettier --write ./",
    "prepare": "husky install",
    "test": "jest",
    "lint-staged": "lint-staged",
    "swagger-codegen": "npx tsx ./swagger-codegen.ts"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": "sh ./scripts/lint-filter.sh"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn run lint-staged"
    }
  },
